# Copy to .env and fill in. Never commit .env (gitignored).
# All paths are relative to the package root. No machine-global paths here.

# Data directory for ledgers, sqlite mirrors, logs, state (default ./data)
ARCADE_DATA_DIR=./data

# Kill-switch file: when present, ARCADE_LIVE_* flags inside gate live loops.
# Leave empty to keep every live loop inert (dry_build + exit 0).
ARCADE_KILL_FILE=

# Live signer keyfile (JSON). Empty = no signer, live loops stay inert.
ARCADE_SIGNER_KEYFILE=
# Live wallet address (informational; balance reads only). Empty by default.
ARCADE_WALLET=

# Solana RPC for balance reads (optional; falls back to public RPC in code).
HELIUS_RPC_URL=

# Telegram board credentials (board only; live loops never read these).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_2=

# Jev forecaster API key (paper engine only; missing key = Jev veto, never approval).
TYPESAFE_API_KEY=

# Scope paper engine/settle to a subset of variant DBs (comma-separated).
PAPER_JEV_ONLY=agree-jev-a,agree-i-pure

# Paper stake / bankroll in micro-USDC.
PAPER_STAKE_MICRO=3000000
PAPER_BANKROLL_MICRO=50000000

# Board display timezone (IANA name).
BOARD_TZ=Asia/Jakarta
