[Unit]
Description=Arcade-OSS paper supervisor (paper + settle + board, never live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install copy: unpack the package, copy .env.example to .env, then point
# WorkingDirectory at the package root. The placeholder below is edited at
# install time and is never a real path in this repo.
WorkingDirectory=/home/USER/arcade-oss
Environment=ARCADE_DATA_DIR=./data
ExecStart=/usr/bin/node /home/USER/arcade-oss/scripts/daemon.mjs
Restart=always
RestartSec=10
TimeoutStopSec=60
StandardOutput=append:/home/USER/arcade-oss/data/daemon.log
StandardError=inherit
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
